# Copy to .env for local development and fill in real credentials.
# Never commit .env or real API tokens.

APP_ENV=development
VISION_API_TOKEN=
VISION_INFERENCE_ENDPOINT=http://127.0.0.1:8001
VISION_REQUEST_TIMEOUT_SECONDS=300

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-3-27b-it
OPENROUTER_MAX_TOKENS=800

GROUNDING_DINO_MODEL_ID=IDEA-Research/grounding-dino-base
SAM2_MODEL_ID=facebook/sam2-hiera-large
MOGE_MODEL_ID=Ruicheng/moge-2-vitl-normal

BOX_THRESHOLD=0.35
TEXT_THRESHOLD=0.25
SHOW_VISUALIZATIONS=false
VISION_MAX_ARRAY_SIDE=512
